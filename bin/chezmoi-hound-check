#!/bin/sh
# chezmoi-hound-check: dotfile drift per side as key<TAB>value records, see README.

set -u

FETCH=0
[ "${1:-}" = "--fetch" ] && FETCH=1

fail() {
    printf 'error\t%s\n' "$1"
    exit 1
}

command -v chezmoi >/dev/null 2>&1 || fail "chezmoi ist nicht im PATH"
command -v git >/dev/null 2>&1 || fail "git ist nicht im PATH"

srcdir=$(chezmoi source-path 2>/dev/null) || srcdir=""
[ -n "$srcdir" ] || srcdir="$HOME/.local/share/chezmoi"
[ -d "$srcdir" ] || fail "kein Quellverzeichnis unter $srcdir"

work=$(mktemp -d "${TMPDIR:-/tmp}/chezmoi-hound.XXXXXX") || fail "kein temporäres Verzeichnis möglich"
trap 'rm -rf "$work"' EXIT INT TERM

side_of() {
    case "$1" in
        .claude|.claude/*) echo claude ;;
        *) echo chezmoi ;;
    esac
}

target_of() {
    case "$1" in
        .*) printf '%s\n' "$1"; return ;;
    esac
    printf '%s\n' "$1" | sed -E \
        -e 's#(^|/)((after|before|create|empty|encrypted|exact|executable|external|literal|modify|once|onchange|private|readonly|remove|run|symlink)_)+#\1#g' \
        -e 's#(^|/)dot_#\1.#g' \
        -e 's#\.(tmpl|literal|age|asc)$##'
}

emit_sourced() {
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        t=$(target_of "$p")
        printf '%s\t%s\t%s\n' "$1" "$(side_of "$t")" "$t"
    done
}

count_commits() {
    for sha in $(git -C "$srcdir" rev-list "$2" 2>/dev/null); do
        git -C "$srcdir" diff-tree --no-commit-id --name-only -r "$sha" 2>/dev/null |
            while IFS= read -r p; do side_of "$(target_of "$p")"; done | sort -u
    done | sort | uniq -c | while read -r n side; do
        printf '%s\t%s\t%s\n' "$1" "$side" "$n"
    done
}

scripts=0
chezmoi status >"$work/status" 2>"$work/status.err" ||
    fail "chezmoi status fehlgeschlagen: $(head -n 1 "$work/status.err")"
while IFS= read -r line; do
    [ "${#line}" -ge 4 ] || continue
    c1=$(printf '%s' "$line" | cut -c1)
    c2=$(printf '%s' "$line" | cut -c2)
    path=${line#?? }
    [ "$c2" = " " ] && continue
    if [ "$c2" = "R" ]; then
        case "$(basename "$(chezmoi source-path "$HOME/$path" 2>/dev/null)")" in
            run_once_*|run_onchange_*) scripts=$((scripts + 1)) ;;
        esac
        continue
    fi
    if [ "$c1" = " " ]; then
        printf 'incoming\t%s\t%s\n' "$(side_of "$path")" "$path"
    else
        printf 'local\t%s\t%s\n' "$(side_of "$path")" "$path"
    fi
done <"$work/status" >"$work/items"

for p in "$HOME/.claude/skills" "$HOME/.claude/hooks" "$HOME/.claude/projects/$(printf '%s' "$HOME" | tr '/' '-')/memory"; do
    [ -e "$p" ] && chezmoi unmanaged -- "$p" 2>/dev/null
done | while IFS= read -r p; do
    [ -n "$p" ] && printf 'local\tclaude\t%s\n' "${p#"$HOME"/}"
done >>"$work/items"

if ! git -C "$srcdir" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'version\t3\n'
    printf 'note\t%s ist kein Git-Repo\n' "$srcdir"
    printf 'scripts\t%s\n' "$scripts"
    sort -u "$work/items"
    exit 0
fi

if [ "$FETCH" = 1 ]; then
    GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=8" \
        timeout -k 2 20 git -C "$srcdir" fetch --quiet >/dev/null 2>"$work/fetch.err" ||
        printf 'note\tAbgleich fehlgeschlagen: %s\n' "$(head -n 1 "$work/fetch.err")" >>"$work/notes"
fi

git -C "$srcdir" -c core.quotePath=false status --porcelain -uall 2>/dev/null |
    cut -c4- | sed -e 's/.* -> //' -e 's/^"//' -e 's/"$//' | emit_sourced local >>"$work/items"

fetchhead=$(git -C "$srcdir" rev-parse --path-format=absolute --git-path FETCH_HEAD 2>/dev/null) || fetchhead=""
fetched=""
[ -f "$fetchhead" ] && fetched=$(date -d "@$(stat -c %Y "$fetchhead")" '+%Y-%m-%d %H:%M' 2>/dev/null)

if git -C "$srcdir" rev-parse --verify -q '@{u}' >/dev/null 2>&1; then
    git -C "$srcdir" diff --name-only 'HEAD...@{u}' 2>/dev/null | emit_sourced incoming >>"$work/items"
    count_commits commits 'HEAD..@{u}' >>"$work/items"
    count_commits unpushed '@{u}..HEAD' >>"$work/items"
else
    printf 'note\tkein Upstream\n' >>"$work/notes"
fi

printf 'version\t3\n'
[ -n "$fetched" ] && printf 'fetched\t%s\n' "$fetched"
printf 'scripts\t%s\n' "$scripts"
sort -u "$work/items"
cat "$work/notes" 2>/dev/null
exit 0
