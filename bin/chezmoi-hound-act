#!/bin/sh
# chezmoi-hound-act: sync one side (chezmoi or claude), or open the default agent on its last failure, see README.

set -u

action=${1:-}
side=${2:-}
case "$action:$side" in
    sync:chezmoi|sync:claude|resolve:chezmoi|resolve:claude) ;;
    *) echo "Aufruf: chezmoi-hound-act sync|resolve chezmoi|claude" >&2; exit 2 ;;
esac

srcdir=$(chezmoi source-path 2>/dev/null) || srcdir=""
[ -n "$srcdir" ] || srcdir="$HOME/.local/share/chezmoi"

statedir="${XDG_RUNTIME_DIR:-$HOME/.cache}/chezmoi-hound"
(umask 077 && mkdir -p "$statedir") || exit 3
lastfile="$statedir/last-$side"

if [ "$action" = resolve ]; then
    [ -f "$lastfile" ] || { echo "kein Fehler gespeichert"; exit 1; }
    src=$(sed -n 's/^source\t//p' "$lastfile")
    [ -d "$src" ] || src=$srcdir
    label=chezmoi
    [ "$side" = claude ] && label=Claude
    prompt=$(printf '%s\n' \
        "Der Sync der Seite \"$label\" im Chezmoi-Hound-Widget ist fehlgeschlagen. Rolle dieser Maschine: $(sed -n 's/^role\t//p' "$lastfile")." \
        "Fehlgeschlagener Schritt: $(sed -n 's/^step\t//p' "$lastfile")" \
        "" "Fehlerausgabe:" "$(sed -n '/^output$/,$p' "$lastfile" | sed 1d | tail -n 30)" \
        "" "git status --short im Quellrepo $src:" "$(git -C "$src" status --short 2>&1 | head -n 40)" \
        "" "Bring Home ($HOME), Quelle ($src) und Remote wieder in Einklang, ohne lokale Änderungen zu verlieren. Erklär mir vor jedem destruktiven Schritt (reset, checkout, Überschreiben, force push), was du vorhast, und warte auf mein Okay.")
    cd "$src" || exit 1
    exec omarchy-agent-prompt "$prompt"
fi

command -v flock >/dev/null 2>&1 && {
    exec 9>"$statedir/act.lock" && flock -n 9 || { echo "error	Ein Sync läuft bereits"; exit 1; }
}

git -C "$srcdir" rev-parse --git-dir >/dev/null 2>&1 || { echo "error	Kein Git-Repo unter $srcdir"; exit 1; }

work=$(mktemp -d "${TMPDIR:-/tmp}/chezmoi-hound-act.XXXXXX") || exit 3
trap 'rm -rf "$work"' EXIT INT TERM
role=$(chezmoi execute-template '{{ .role }}' 2>/dev/null) || role=""
[ -n "$role" ] || role=$(hostname)
rm -f "$lastfile"
gitdir=$(git -C "$srcdir" rev-parse --absolute-git-dir)

fail() {
    {
        printf 'side\t%s\nstep\t%s\nrole\t%s\nsource\t%s\noutput\n' "$side" "$2" "$role" "$srcdir"
        tail -n 60 "$work/out" 2>/dev/null
    } >"$lastfile"
    printf 'error\t%s\n' "$1"
    exit 1
}

run() {
    "$@" >"$work/out" 2>&1 </dev/null
}

side_of() {
    case "$1" in
        .claude|.claude/*) echo claude ;;
        *) echo chezmoi ;;
    esac
}

target_of() {
    case "$1" in
        .*) printf '%s\n' "$1"; return ;;
    esac
    printf '%s\n' "$1" | sed -E \
        -e 's#(^|/)((after|before|create|empty|encrypted|exact|executable|external|literal|modify|once|onchange|private|readonly|remove|run|symlink)_)+#\1#g' \
        -e 's#(^|/)dot_#\1.#g' \
        -e 's#\.(tmpl|literal|age|asc)$##'
}

status_of_side() {
    chezmoi status 2>/dev/null | while IFS= read -r line; do
        [ "${#line}" -ge 4 ] || continue
        path=${line#?? }
        [ "$(side_of "$path")" = "$side" ] && printf '%s\n' "$line"
    done
}

if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ] || [ -f "$gitdir/MERGE_HEAD" ]; then
    git -C "$srcdir" status >"$work/out" 2>&1
    fail "Rebase oder Merge offen" preflight
fi

status_of_side >"$work/status"
: >"$work/templates"
while IFS= read -r line; do
    c1=$(printf '%s' "$line" | cut -c1)
    c2=$(printf '%s' "$line" | cut -c2)
    path=${line#?? }
    case "$c1$c2" in
        " "?|?" "|?R) continue ;;
        DA) run chezmoi forget --force --no-tty "$HOME/$path" || fail "Konnte $path nicht aus der Quelle entfernen" capture ;;
        *)
            case "$(chezmoi source-path "$HOME/$path" 2>/dev/null)" in
                *.tmpl) printf '%s\n' "$path" >>"$work/templates"; continue ;;
            esac
            run chezmoi add --no-tty "$HOME/$path" || fail "Konnte $path nicht übernehmen" capture
            ;;
    esac
done <"$work/status"

if [ "$side" = claude ]; then
    for p in "$HOME/.claude/skills" "$HOME/.claude/hooks" "$HOME/.claude/projects/$(printf '%s' "$HOME" | tr '/' '-')/memory"; do
        [ -e "$p" ] && chezmoi unmanaged -- "$p" 2>/dev/null
    done >"$work/new"
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        case "$p" in /*) ;; *) p="$HOME/$p" ;; esac
        run chezmoi add --no-tty "$p" || fail "Konnte ${p#"$HOME"/} nicht übernehmen" capture
    done <"$work/new"
fi

git -C "$srcdir" -c core.quotePath=false status --porcelain -uall 2>/dev/null |
    cut -c4- | sed -e 's/.* -> //' -e 's/^"//' -e 's/"$//' | while IFS= read -r p; do
        [ "$(side_of "$(target_of "$p")")" = "$side" ] && printf '%s\n' "$p"
    done >"$work/paths"

if [ -s "$work/paths" ]; then
    run git -C "$srcdir" add -A --pathspec-from-file="$work/paths" || fail "git add fehlgeschlagen" commit
    if ! xargs -d '\n' git -C "$srcdir" diff --cached --quiet -- <"$work/paths"; then
        run git -C "$srcdir" commit -q -m "chore: sync $side from $role" --pathspec-from-file="$work/paths" ||
            fail "Commit fehlgeschlagen" commit
    fi
fi

if git -C "$srcdir" rev-parse --verify -q '@{u}' >/dev/null 2>&1; then
    export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=8"
    if ! run timeout -k 2 60 git -C "$srcdir" pull --rebase --autostash --quiet; then
        if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; then
            git -C "$srcdir" rebase --abort >/dev/null 2>&1
            fail "Rebase-Konflikt, abgebrochen" pull
        fi
        fail "Pull fehlgeschlagen" pull
    fi
    if [ "$(git -C "$srcdir" rev-list --count '@{u}..HEAD')" -gt 0 ]; then
        run timeout -k 2 60 git -C "$srcdir" push --quiet || fail "Push abgelehnt" push
    fi
fi

status_of_side | while IFS= read -r line; do
    case "$line" in
        "  "*|" R"*) ;;
        " "*) printf '%s\n' "$HOME/${line#?? }" ;;
    esac
done >"$work/apply"
if [ -s "$work/apply" ]; then
    set --
    while IFS= read -r t; do set -- "$@" "$t"; done <"$work/apply"
    run chezmoi apply --no-tty --exclude scripts -- "$@" || fail "Anwenden fehlgeschlagen" apply
fi

if [ "$side" = chezmoi ]; then
    chezmoi status 2>/dev/null | while IFS= read -r line; do
        [ "$(printf '%s' "$line" | cut -c2)" = R ] || continue
        case "$(basename "$(chezmoi source-path "$HOME/${line#?? }" 2>/dev/null)")" in
            run_once_*|run_onchange_*) echo due ;;
        esac
    done >"$work/due"
    if [ -s "$work/due" ]; then
        run chezmoi apply --no-tty --include scripts || fail "Skripte fehlgeschlagen (sudo/TTY?)" scripts
    fi
fi

if [ -s "$work/templates" ]; then
    cp "$work/templates" "$work/out"
    fail "Vorlage, nicht übernommen: $(head -n 1 "$work/templates")" capture
fi

printf 'ok\tsynchron\n'
